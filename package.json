{
  "name": "open-clone",
  "productName": "Open Clone",
  "version": "0.1.0",
  "description": "Clone your voice and speak with expression, entirely on your Mac.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc",
    "dist:x64": "npm run runtime:x64 && electron-vite build && electron-builder --mac --x64",
    "dist:arm64": "npm run runtime:arm64 && electron-vite build && electron-builder --mac --arm64",
    "dist": "npm run dist:x64 && npm run dist:arm64",
    "e2e": "electron-vite build && tsx scripts/e2e-smoke.ts",
    "runtime:x64": "scripts/build-python-runtime.sh x64",
    "runtime:arm64": "scripts/build-python-runtime.sh arm64",
    "test:engine": "build/python-x64/bin/python3 -m unittest python/test_engine.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "out/main/index.js",
  "author": "statiiiix"
}
